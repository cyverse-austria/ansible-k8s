#---------------------------------------------------------------------
# Example configuration for a possible web application.  See the
# full configuration options online.
#
#   http://haproxy.1wt.eu/download/1.4/doc/configuration.txt
#
#---------------------------------------------------------------------
#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    # to have these messages end up in /var/log/haproxy.log you will
    # need to:
    #
    # 1) configure syslog to accept network log events.  This is done
    #    by adding the '-r' option to the SYSLOGD_OPTIONS in
    #    /etc/sysconfig/syslog
    #
    # 2) configure local2 events to go to the /var/log/haproxy.log
    #   file. A line like the following can be added to
    #   /etc/sysconfig/syslog
    #
    #    local2.*                       /var/log/haproxy.log
    #
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon

    ssl-default-bind-ciphers ECDH+AESGCM:DH+AESGCM:ECDH+AES256:DH+AES256:ECDH+AES128:DH+AES:RSA+AESGCM:RSA+AES:!aNULL:!MD5:!DSS
    ssl-default-bind-options no-sslv3
    tune.ssl.default-dh-param 2048

    # turn on stats unix socket
    stats socket /var/lib/haproxy/stats

#---------------------------------------------------------------------
# common defaults that all the 'listen' and 'backend' sections will
# use if not designated in their block
#---------------------------------------------------------------------
defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option http-server-close
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          60m
    timeout server          60m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

frontend localhost
    bind *:80
    redirect scheme https

frontend http2-ssl
    bind *:443 ssl crt {{ tls_pem_path }}

    acl portal hdr(host) -i {{ userportal }}
    acl keycloak hdr(host) -i {{ keycloak }}
    acl de hdr(host) -i {{ de_hostname }}


    # HSTS (63072000 seconds)
    http-response set-header Strict-Transport-Security max-age=63072000

    use_backend discoenv if portal
    use_backend discoenv if de
    use_backend keycloak if keycloak
    default_backend discoenv

backend discoenv
    option log-health-checks
    option forwardfor

    http-request add-header X-Forwarded-Proto https

    balance roundrobin
{% for host in groups['k8s-workers'] %}
    server   s{{ loop.index }} {{ hostvars[host].ansible_fqdn }}:31378 ssl verify none check inter 5000
{% endfor %}


backend keycloak
    balance roundrobin
    option  log-health-checks
    option  forwardfor
{% for host in groups['k8s-workers'] %}
    server   s{{ loop.index }} {{ hostvars[host].ansible_fqdn }}:31360 check
{% endfor %}

